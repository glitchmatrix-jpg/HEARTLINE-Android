<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/notification_mark"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="#F7D7F1"
        android:text="♥"
        android:textColor="#8D4D9F"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#2D1732"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#5B3E62"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/notification_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:background="#D58BE2"
        android:textColor="#2D1732"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
